# Copia este archivo a .env en la raiz del proyecto.
# .env no se sube a git. Ahi viven las claves, no en el codigo.

DB_ROOT_PASSWORD=cambia-esta-clave
DB_NAME=mysticalcut-db

# Direccion publica de la app. En tu PC puede quedar asi.
# En Amazon pon la IP o el dominio, por ejemplo http://18.xxx.xxx.xxx
PUBLIC_URL=http://localhost
